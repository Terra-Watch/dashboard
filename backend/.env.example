DATABASE_URL=postgresql+psycopg://resq:resq@localhost:55432/resq
RESQ_SECRET_KEY=replace-with-a-long-random-value-at-least-32-characters
# Exported, versioned model bundle; the running app never reads the research repo.
RESQ_MODEL_BUNDLE_DIR=/absolute/path/to/resq-model-bundle
# Optional Fire Evidence Assessor integration. Both values are required for
# real inference; otherwise uploads remain persisted with UNAVAILABLE status.
FIRE_EVIDENCE_REPO=/absolute/path/to/fire-evidence-assessor
FIRE_EVIDENCE_ARTIFACT_DIR=/absolute/path/to/verified-fire-assessor-artifact
FIRE_EVIDENCE_MODEL_VERSION=fire-assessor-v1.0.0
