# Application settings reserved for the backend foundation.
JALRI_ENVIRONMENT=development
JALRI_API_HOST=127.0.0.1
JALRI_API_PORT=8000

# PostgreSQL connection used by the database foundation.
# Use timezone-aware UTC application datetimes.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/jalri
JALRI_CORS_ORIGINS=http://localhost:3000
