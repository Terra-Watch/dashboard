DATABASE_URL=postgresql+psycopg://resq:resq@localhost:55432/resq
RESQ_SECRET_KEY=replace-with-a-long-random-value-at-least-32-characters
# Production: set this to the exact Vercel deployment origin(s), comma-separated.
# Example: https://terrawatch.vercel.app,https://www.example.org
# API_ORIGINS=https://your-project.vercel.app
# Production object storage (keep the bucket private; use backend-generated URLs).
# GOOGLE_CLOUD_PROJECT=ace-sequencer-478304
# GCS_BUCKET_NAME=terrawatch-fire-ace-478304
# Vercel Blob (private). Keep the token in the backend deployment environment only.
# BLOB_STORAGE_ENABLED=false
# BLOB_READ_WRITE_TOKEN=<backend-only-vercel-blob-token>
# BLOB_STORE_ID=<vercel-blob-store-id-if-using-oidc>
# RESQ_MAX_IMAGE_BYTES=4194304
# Exported, versioned model bundle; the running app never reads the research repo.
RESQ_MODEL_BUNDLE_DIR=/absolute/path/to/resq-model-bundle
# Optional Fire Evidence Assessor integration. Both values are required for
# real inference; otherwise uploads remain persisted with UNAVAILABLE status.
FIRE_EVIDENCE_REPO=/absolute/path/to/fire-evidence-assessor
FIRE_EVIDENCE_ARTIFACT_DIR=/absolute/path/to/verified-fire-assessor-artifact
FIRE_EVIDENCE_MODEL_VERSION=fire-assessor-v1.0.0
# Inference is OFF unless this is exactly "true". Even when true, the artifact must be
# complete, APPROVED and bound to its approval record, or every upload stays UNAVAILABLE.
FIRE_EVIDENCE_INFERENCE_ENABLED=false
# Shadow mode (incident evidence only): when true AND inference is enabled with an APPROVED artifact, assessments are stored but never shown or used
# (staff/citizen/ranger responses show only status SHADOW). No effect on community moderation. Report with: python -m scripts.shadow_report
# FIRE_EVIDENCE_SHADOW_MODE=false
# Advisory media-integrity signal on incident images (exactly "true" to enable). The authenticity research head must not be used operationally;
# this only exposes an authenticity component an APPROVED artifact already contains. Never changes fire fields, status, priority, dispatch or visibility.
# FIRE_EVIDENCE_REPORT_AUTHENTICITY_ENABLED=false
# Four gates before enabling inference for staff: policy selected; phone-photo evaluation reviewed; named owner approves the exact artifact; shadow mode completed against Control Room decisions.
# Optional Ed25519 verification of approval.signature. ENFORCED ONLY WHEN THE PUBLIC KEY IS SET (unset = signature not checked; see docs/fire_evidence_integration.md).
# Independent Ed25519 public verification key for approved artifacts. Never store the private key here.
# FIRE_EVIDENCE_TRUSTED_PUBLIC_KEY=<base64-ed25519-public-key>
# FIRE_EVIDENCE_TRUSTED_KEY_ID=<deployment-key-id>
# Per-image wall-clock limit and the number of queued/running assessments before new ones are skipped (UNAVAILABLE / MODEL_BUSY).
FIRE_EVIDENCE_TIMEOUT_S=20
FIRE_EVIDENCE_MAX_PENDING=2

# --- DEVELOPMENT-ONLY experimental inference (EXPERIMENTAL / NOT FOR OPERATIONAL USE) -----------------------------------
# Leave all of these unset in every shared, staging or production environment. All four must be set for it to run, and
# TERRAWATCH_ENV must be an explicit development value (development|dev|local|test); anything else, including unset, is production.
# It cannot run while FIRE_EVIDENCE_INFERENCE_ENABLED=true, accepts only the one audited checkpoint hash pinned in
# backend/app/services/image_assessment.py, and only ever records status EXPERIMENTAL (raw uncalibrated logits) or UNAVAILABLE.
# Needs torch + open_clip in the backend's Python (assessor: requirements/experimental-inference.txt).
# TERRAWATCH_ENV=development
# FIRE_EVIDENCE_EXPERIMENTAL_ENABLED=true
# FIRE_EVIDENCE_EXPERIMENTAL_CHECKPOINT=/absolute/path/to/runs_lora_s0/weights.pt
# FIRE_EVIDENCE_EXPERIMENTAL_PROVENANCE=/absolute/path/to/fire-evidence-assessor/docs/provenance/lora_s0_provenance.json
# FIRE_EVIDENCE_TIMEOUT_S=120   # first request loads the 345 MB model (about 7 s on 4 CPU cores); raise the default 20 s if needed

# --- Community image moderation (separate from incident evidence; both OFF unless exactly true) --------------------------
# COMMUNITY_IMAGES_ENABLED=false            # accept one re-encoded (EXIF-stripped) jpeg/png/webp per community post
# FIRE_EVIDENCE_COMMUNITY_ENABLED=false     # also run the media-authenticity check; anything but "no concern found" (incl. unavailable) holds the post for a moderator
# Community moderation uses its OWN artifact (approved separately). Unset = the check is UNAVAILABLE and posts are held; it never falls back to FIRE_EVIDENCE_ARTIFACT_DIR.
# FIRE_EVIDENCE_COMMUNITY_ARTIFACT_DIR=/absolute/path/to/community-authenticity-artifact
# FIRE_EVIDENCE_COMMUNITY_MODEL_VERSION=fire-assessor-v1.0.0
# COMMUNITY_IMAGE_MAX_BYTES=5242880         # upload limit (10 KB .. 10 MB)
# COMMUNITY_IMAGE_STORAGE_DIR=/absolute/path/to/community_images   # default: backend/runtime_data/community_images
