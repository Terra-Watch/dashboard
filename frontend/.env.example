# Backend API base URL (FastAPI server)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "true" to enable the demo simulator panel (SimulationControls).
# NEVER set this to "true" in production — it exposes internal simulation tools.
NEXT_PUBLIC_ENABLE_DEMO_SIMULATOR=false

# Supabase Authentication Configuration (Optional - Can also be set in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

