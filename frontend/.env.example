VITE_API_BASE_URL=http://localhost:8000
# Vercel production: set this in Vercel Project Settings, not in committed files.
# VITE_API_BASE_URL=https://your-backend.example.com

# Optional satellite basemap toggle (Control Room only)
# VITE_SATELLITE_BASEMAP=true
# VITE_SATELLITE_TILE_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/MODIS_Terra_CorrectedReflectance_TrueColor/default/GoogleMapsCompatible_Level9/{z}/{y}/{x}.jpg
# VITE_SATELLITE_ATTRIBUTION=NASA EOSDIS GIBS
#
# What-if page satellite view (opt-in; off unless all of these are set). Vite copies VITE_* values into the built site, so
# the token must be a PUBLIC browser token (pk.), restricted to your site's URLs in the Mapbox account. Never a secret (sk.) token.
# Option 1, Mapbox Satellite (needs a token; check Mapbox terms before public use):
# VITE_SATELLITE_BASEMAP=true
# VITE_SATELLITE_TILE_URL=https://api.mapbox.com/v4/mapbox.satellite/{z}/{x}/{y}@2x.jpg90?access_token=<your-mapbox-public-token>
# VITE_SATELLITE_ATTRIBUTION="© Mapbox © OpenStreetMap © Maxar"
# VITE_SATELLITE_NOTE="Imagery: Mapbox / Maxar (token required; check terms before public deployment)."
# VITE_SATELLITE_MAX_ZOOM=17
# Optional Mapbox Terrain-RGB hillshade overlay for satellite views.
# VITE_HILLSHADE_TILE_URL=https://api.mapbox.com/v4/mapbox.terrain-rgb/{z}/{x}/{y}.pngraw?access_token=<your-mapbox-public-token>
#
# Option 2, no key: EOX Sentinel-2 cloudless 2023 (10 m). Licence CC BY-NC-SA 4.0: NON-COMMERCIAL; commercial use needs a paid EOX licence.
# VITE_SATELLITE_BASEMAP=true
# VITE_SATELLITE_TILE_URL=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2023_3857/default/g/{z}/{y}/{x}.jpg
# VITE_SATELLITE_ATTRIBUTION=EOxCloudless https://cloudless.eox.at by EOX IT Services GmbH (Contains modified Copernicus Sentinel data 2023)
# VITE_SATELLITE_NOTE=Imagery licence: non-commercial (EOX CC BY-NC-SA 4.0).
# VITE_SATELLITE_MAX_ZOOM=13
