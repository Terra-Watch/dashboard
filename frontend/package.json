{
  "name": "resq-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test:unit": "node scripts/palette.mjs && node --experimental-strip-types --test unit/*.unit.ts",
    "palette": "node scripts/palette.mjs",
    "palette:write": "node scripts/palette.mjs --write",
    "budget": "node scripts/budget.mjs",
    "i18n": "node --experimental-strip-types scripts/i18n-report.mjs --strict"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-oriya": "^5.3.0",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@protomaps/basemaps": "^5.7.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@tanstack/react-query": "^5.62.7",
    "clsx": "^2.1.1",
    "h3-js": "^4.5.0",
    "i18next": "^26.4.7",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.58.0",
    "maplibre-gl": "^6.14.0",
    "motion": "^11.15.0",
    "pmtiles": "^3.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.19",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "colorjs.io": "^0.7.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^7.1.7"
  }
}
